{
  "$id": "https://kyeprotocol.com/schemas/credential.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "credential_type", "issuer_entity_id", "subject_entity_id", "format", "status"],
  "properties": {
    "credential_id": { "$ref": "common.json#/$defs/KyeId" },
    "credential_type": {
      "enum": [
        "kye_entity_passport", "kye_workload_passport", "kye_agent_passport",
        "kye_model_passport", "kye_delegation_credential", "kye_scope_credential",
        "kye_approval_credential", "kye_revocation_credential", "kye_transfer_credential"
      ]
    },
    "issuer_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "holder_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "subject_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "format": { "enum": ["kye-json", "jwt", "cwt", "vc+jwt", "vc+cose", "vc+di"] },
    "claims": { "type": "object" },
    "status": { "enum": ["valid", "suspended", "revoked", "expired"] },
    "issued_at": { "$ref": "common.json#/$defs/DateTime" },
    "expires_at": { "$ref": "common.json#/$defs/DateTime" }
  }
}
