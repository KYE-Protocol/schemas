{
  "$id": "https://kyeprotocol.com/schemas/signal.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "signal_type", "issued_at"],
  "properties": {
    "signal_id": { "$ref": "common.json#/$defs/KyeId" },
    "signal_type": {
      "enum": [
        "entity.stop", "entity.quarantine", "entity.revoked",
        "credential.revoked", "credential.suspended",
        "delegation.revoked", "scope.attenuated", "session.revoked",
        "risk.threshold_exceeded", "workload.attestation_failed",
        "model.blocked", "tool.blocked", "consent.withdrawn",
        "payment.stop", "payment.quarantine",
        "payment_authority.revoked", "wallet.use_revoked",
        "beneficiary.deactivated", "merchant.blocked",
        "payment_scope.attenuated", "treasury.program.frozen",
        "rail_adapter.blocked"
      ]
    },
    "target_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "issued_by_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "reason_code": { "type": "string" },
    "effect": { "enum": ["immediate_stop", "quarantine", "revoke", "attenuate"] },
    "applies_to": { "$ref": "common.json#/$defs/StringArray" },
    "payload": { "type": "object" },
    "issued_at": { "$ref": "common.json#/$defs/DateTime" }
  }
}
