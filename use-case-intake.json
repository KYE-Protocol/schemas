{
  "$id": "https://kyeprotocol.com/schemas/use-case-intake.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Use-Case Intake",
  "description": "Initial proposal for a delegated AI worker / agent / workflow / service. Records actor type, expected actions, systems touched, data classes, external effects, commit actions and an initial risk assessment. Stage 1 of the KYE Operating Model Profile™ journey.",
  "type": "object",
  "required": [
    "schema_version",
    "use_case_id",
    "title",
    "actor_type",
    "expected_actions",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kye.use_case_intake.v1"
    },
    "use_case_id": {
      "type": "string",
      "pattern": "^kye:use-case:"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "requesting_team": {
      "type": "object",
      "required": [
        "team_id",
        "owner_entity_id"
      ],
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "owner_entity_id": {
          "type": "string",
          "pattern": "^kye:[a-z][a-z0-9-]*:[A-Za-z0-9._:{}-]+$"
        },
        "entity_class": {
          "type": "string",
          "description": "§0.36 limb (c) self-declared artefact class — a term in kye:dictionary:entity-id-classes (membership enforced by admission-control; §0.49)."
        }
      }
    },
    "business_objective": {
      "type": "string"
    },
    "actor_type": {
      "enum": [
        "ai_agent",
        "workflow",
        "service",
        "model",
        "tool",
        "connector",
        "human_in_the_loop"
      ]
    },
    "expected_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "systems_touched": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "external_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commit_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "initial_risk_assessment": {
      "type": "object",
      "required": [
        "risk_tier"
      ],
      "additionalProperties": false,
      "properties": {
        "risk_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "entity_class": {
          "type": "string",
          "description": "§0.36 limb (c) self-declared artefact class — a term in kye:dictionary:entity-id-classes (membership enforced by admission-control; §0.49)."
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "entity_class": {
      "type": "string",
      "description": "§0.36 limb (c) self-declared artefact class — a term in kye:dictionary:entity-id-classes (membership enforced by admission-control; §0.49)."
    }
  }
}
