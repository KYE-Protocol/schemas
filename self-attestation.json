{
  "$id": "https://kyeprotocol.com/schemas/self-attestation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Self-Attestation",
  "description": "Signed declaration a KYE implementation publishes after a self-audit run. Establishes KYE Self-Tested™ (L1) or KYE Self-Attested™ (L2). Distinct from KYE Certified™ which requires program review.",
  "type": "object",
  "required": ["schema_version", "attestation_id", "organisation_entity_id", "implementation_name", "implementation_version", "attestation_type", "claims", "issued_at", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version":     { "type": "string", "enum": ["kye.self_attestation.v1"] },
    "attestation_id":     { "type": "string", "pattern": "^kye:self-attestation:.+" },
    "organisation_entity_id": { "type": "string" },
    "implementation_name":{ "type": "string" },
    "implementation_version": { "type": "string" },
    "attestation_type":   { "type": "string", "enum": ["self_tested", "self_attested_conformance", "programme_conformant", "certified"] },
    "kye_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "status"],
        "additionalProperties": false,
        "properties": {
          "claim":  { "type": "string" },
          "status": { "type": "string", "enum": ["true", "partial", "false", "not_applicable"] },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "self_audit_run_ref": { "type": "string" },
    "evidence_pack_ref":  { "type": "string" },
    "signed_by":          { "type": "string" },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm":               { "type": "string" },
        "signature":               { "type": "string" },
        "signed_by_credential_id": { "type": "string" }
      }
    },
    "status":             { "type": "string", "enum": ["draft", "signed", "published", "expired", "revoked", "superseded"] },
    "issued_at":          { "type": "string", "format": "date-time" },
    "expires_at":         { "type": "string", "format": "date-time" }
  }
}
