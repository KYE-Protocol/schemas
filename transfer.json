{
  "$id": "https://kyeprotocol.com/schemas/transfer.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["transfer_id", "entity_id", "from_owner_entity_id", "to_owner_entity_id", "status"],
  "properties": {
    "transfer_id": { "$ref": "common.json#/$defs/KyeId" },
    "entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "from_owner_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "to_owner_entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "from_trust_domain_id": { "$ref": "common.json#/$defs/KyeId" },
    "to_trust_domain_id": { "$ref": "common.json#/$defs/KyeId" },
    "requires_reverification": { "type": "boolean" },
    "requires_reissue": { "type": "boolean" },
    "status": { "enum": ["pending", "accepted", "completed", "rejected", "rolled_back"] },
    "requested_at": { "$ref": "common.json#/$defs/DateTime" },
    "completed_at": { "$ref": "common.json#/$defs/DateTime" }
  }
}
