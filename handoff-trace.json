{
  "$id": "https://kyeprotocol.com/schemas/handoff-trace.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Handoff Trace",
  "description": "Ordered record of every meaning-bearing handoff in a delegated agentic chain (principal -> agent -> sub-agent -> tool). Carries per-handoff meaning before, meaning after, meaning delta and risk level. Consumed by KYE Meaning Continuity Engine to score aggregate handoff risk. See kye-meaning-continuity-v1.md.",
  "type": "object",
  "required": ["schema_version", "handoff_trace_id", "handoffs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "kye.handoff_trace.v1" },
    "handoff_trace_id": { "type": "string", "pattern": "^kye:handoff-trace:" },
    "continuity_id": { "type": "string", "pattern": "^kye:continuity:" },
    "meaning_continuity_id": { "type": "string", "pattern": "^kye:meaning-continuity:" },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "handoff_id",
          "from_entity_id",
          "to_entity_id",
          "handoff_type",
          "timestamp"
        ],
        "additionalProperties": false,
        "properties": {
          "handoff_id": { "type": "string", "pattern": "^kye:handoff:" },
          "from_entity_id": { "type": "string" },
          "to_entity_id": { "type": "string" },
          "handoff_type": {
            "enum": [
              "human_to_agent_instruction",
              "agent_to_agent_delegation",
              "agent_to_sub_agent_delegation",
              "agent_to_tool_request",
              "tool_to_agent_response",
              "agent_to_human_clarification",
              "agent_to_human_reconfirmation"
            ]
          },
          "meaning_before": { "type": "string" },
          "meaning_after": { "type": "string" },
          "meaning_delta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lost_constraints": {
                "type": "array",
                "items": { "type": "string" }
              },
              "added_constraints": {
                "type": "array",
                "items": { "type": "string" }
              },
              "added_assumptions": {
                "type": "array",
                "items": { "type": "string" }
              },
              "removed_assumptions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "aggregate_handoff_risk": { "enum": ["low", "medium", "high", "critical"] },
    "meaning_drift_detected": { "type": "boolean" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
