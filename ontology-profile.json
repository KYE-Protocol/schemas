{
  "$id": "https://kyeprotocol.com/schemas/ontology-profile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Ontology Profile",
  "description": "Profile manifest for KYE Ontology Profile™ — the semantic layer that defines shared meaning of entities, authorities, capabilities, scopes, states, decisions, evidence, profiles, connectors and sectors across KYE implementations.",
  "type": "object",
  "required": ["schema_version", "profile_id", "display_name", "category", "version", "ontology_domains", "supported_serializations", "access_model", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "kye.ontology_profile.v1" },
    "profile_id": { "type": "string", "pattern": "^kye:profile:ontology" },
    "display_name": { "type": "string" },
    "category": { "enum": ["semantic_authority"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "required_kye_profiles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "recommended_kye_profiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ontology_domains": {
      "type": "array",
      "items": { "enum": ["entity", "authority", "capability", "scope", "state", "decision", "evidence", "continuity", "discoverability", "connector", "sector", "certification"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "supported_serializations": {
      "type": "array",
      "items": { "enum": ["json", "json_ld", "rdf_optional", "owl_optional"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "access_model": { "enum": ["policy_filtered", "open", "tenant_scoped"] },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
