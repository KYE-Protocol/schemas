{
  "$id": "https://kyeprotocol.com/schemas/identifier.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier_id", "entity_id", "identifier_type", "value_hash", "status"],
  "properties": {
    "identifier_id": { "$ref": "common.json#/$defs/KyeId" },
    "entity_id": { "$ref": "common.json#/$defs/KyeId" },
    "identifier_type": { "type": "string" },
    "value_hash": { "$ref": "common.json#/$defs/Hash" },
    "display_hint": { "type": "string" },
    "verified": { "type": "boolean" },
    "verification_basis": { "type": "string" },
    "status": { "enum": ["active", "superseded", "revoked"] },
    "created_at": { "$ref": "common.json#/$defs/DateTime" }
  }
}
