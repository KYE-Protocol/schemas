{
  "$id": "https://kyeprotocol.com/schemas/conformance-run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Conformance Run",
  "description": "One execution of the KYE conformance test pack against a target implementation. Companion to conformance-report.json (the official summary) and certification-record.json (the public-trust record).",
  "type": "object",
  "required": ["schema_version", "run_id", "implementation_id", "test_suite_version", "started_at", "result"],
  "additionalProperties": false,
  "properties": {
    "schema_version":     { "type": "string", "enum": ["kye.conformance_run.v1"] },
    "run_id":             { "type": "string", "pattern": "^kye:conformance-run:.+" },
    "implementation_id":  { "type": "string" },
    "implementation_name":{ "type": "string" },
    "implementation_version": { "type": "string" },
    "test_suite_version": { "type": "string", "pattern": "^kye-conformance-\\d+\\.\\d+\\.\\d+$" },
    "profiles_under_test":{ "type": "array", "items": { "type": "string" } },
    "started_at":         { "type": "string", "format": "date-time" },
    "completed_at":       { "type": "string", "format": "date-time" },
    "result":             { "type": "string", "enum": ["passed", "passed_with_warnings", "failed", "incomplete", "not_applicable"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_total":   { "type": "integer", "minimum": 0 },
        "tests_passed":  { "type": "integer", "minimum": 0 },
        "tests_failed":  { "type": "integer", "minimum": 0 },
        "warnings":      { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "area"],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "type": "string" },
          "severity":   { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "area":       { "type": "string" },
          "reason_code":{ "type": "string" },
          "message":    { "type": "string" }
        }
      }
    },
    "evidence_pack_ref":  { "type": "string" }
  }
}
