{
  "$id": "https://kyeprotocol.com/schemas/continuity-profile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Continuity Profile",
  "description": "Defines schemas, events, decisions, evidence objects and conformance checks for preserving continuity between original intent, interpreted intent, delegated authority, capability selection, state, policy decision, execution and audit evidence. See kye-continuity-v1.md.",
  "type": "object",
  "required": ["schema_version", "profile_id", "display_name", "version", "required_kye_profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "kye.continuity_profile.v1" },
    "profile_id": { "type": "string", "pattern": "^kye:profile:[a-z0-9-]+$" },
    "display_name": { "type": "string" },
    "category": { "type": "string", "const": "delegated_agency_governance" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "required_kye_profiles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_objects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modules": {
      "type": "array",
      "items": {
        "enum": [
          "intent_continuity",
          "meaning_continuity",
          "context_continuity",
          "memory_continuity",
          "incentive_continuity",
          "timing_continuity",
          "handoff_continuity",
          "state_continuity",
          "execution_continuity"
        ]
      },
      "uniqueItems": true
    },
    "decision_types": {
      "type": "array",
      "items": {
        "enum": [
          "continuity_preserved",
          "continuity_degraded",
          "continuity_broken",
          "require_human_review",
          "require_reconfirmation",
          "deny",
          "quarantine"
        ]
      }
    },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "status": { "enum": ["draft", "active", "deprecated"] }
  }
}
