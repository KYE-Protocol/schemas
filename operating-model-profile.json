{
  "$id": "https://kyeprotocol.com/schemas/operating-model-profile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYE Operating Model Profile",
  "description": "Profile manifest for KYE Operating Model Profile™ — the enterprise adoption layer that defines the journey from use-case intake to runtime authority control.",
  "type": "object",
  "required": ["schema_version", "profile_id", "display_name", "category", "version", "required_objects", "journey_stages", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "kye.operating_model_profile.v1" },
    "profile_id": { "type": "string", "pattern": "^kye:profile:operating_model" },
    "display_name": { "type": "string" },
    "category": { "enum": ["ai_worker_governance"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "required_kye_profiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "recommended_kye_profiles": { "type": "array", "items": { "type": "string" } },
    "required_objects": {
      "type": "array",
      "items": { "enum": ["KYEUseCaseIntake", "KYEReadinessAssessment", "KYEEntityAuthorityRecord", "KYEAuthorityGate", "KYECommitBoundary", "KYEReviewPath", "KYETrainingRecord", "KYEAdoptionEvidencePack", "KYEGovernedCatalogEntry"] },
      "minItems": 1, "uniqueItems": true
    },
    "journey_stages": {
      "type": "array",
      "items": { "enum": ["intake", "assess", "classify", "map_authority", "place_gates", "configure_runtime", "execute", "evidence", "review", "improve"] },
      "minItems": 1, "uniqueItems": true
    },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
